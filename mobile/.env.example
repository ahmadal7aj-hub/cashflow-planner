# Names only. Copy to `.env.local` (git-ignored) and fill in locally. NEVER commit real values.
# Only EXPO_PUBLIC_* values are bundled into the app; never put service-role keys or secrets here.

# development | staging | production  (unknown values fall back to development)
EXPO_PUBLIC_APP_ENV=

# Supabase project for THIS environment (added in Phase 2). The anon key is public by design,
# protected by RLS; the service-role key must never exist in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
